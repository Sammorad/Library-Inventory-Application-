<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ayCode Library</title>
    <link rel="stylesheet" href="/output.css">
</head>
<body class="bg-gray-400">
     <%- include('navbar') %>
     <section class="flex flex-col items-center">
        <h1>Add New Courses Here </h1>
    <Form action="/courses/courseForm" method="POST" class="bg-white w-2/5 ">
        <label for="newCourse">Course Name</label>
        <input class="border-black border-2" type="text" name="newCourse" id="newCourse">
        <div class="flex justify-around">
            <button>Submit</button>
            <button type="button" onclick="location.href='/courses'">Cancel</button>
        </div>
        
    </Form>
     </section>

    
</body>
</html>