<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ayCode Library</title>
    <link rel="stylesheet" href="/output.css">
</head>
<body class="bg-gray-400">
     <%- include('navbar') %>
     <section class="flex flex-col items-center justify-center px-4 py-8">
        <h1 class="m-9 font-semibold text-3xl ">Add New Courses Here </h1>
    <Form action="/courses/courseForm" method="POST" class="bg-white p-6 w-full max-w-md space-y-5 rounded-xl">
        
    <div class="flex flex-col gap-1">
    <label for="course" class="text-sm font-semibold">Course</label>
      <input type="text" name="course" placeholder="Enter Course" required
        class="rounded-md border border-gray-400 px-3 py-2 focus:border-red-600 focus:outline-none focus:ring-2 focus:ring-red-200"> 
         </div>
    <div class="flex flex-col gap-3 sm:flex-row sm:justify-end">
        <button class="rounded-md bg-red-600 px-4 py-2 font-semibold text-white hover:bg-red-700">Submit</button>
        <button type="button" onclick="location.href='/courses'" class="rounded-md border border-gray-400 px-4 py-2 text-center hover:bg-gray-100">Cancel</button>
    </div>
        
    </Form>
     </section>

    
</body>
</html>