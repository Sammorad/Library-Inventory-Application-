<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ayCode Library</title>
    <link rel="stylesheet" href="/output.css">
</head>
<body >
<header class="text-red-600 flex justify-between m-4">
    
        <h1>AyCode Library</h1>
        <form action="">
            <input type="text" name="course" class="border-2 border-black">
            <button>Add</button>
        </form>
        <nav>
            <a href="">Add Courses</a>
            <a href="">Add Books </a>
        </nav>
    

</header>
<section>
    <p>Education is a priority </p>
    <ul>
        <% courses.map((item) =>{ %>
            <li><%= item.course  %></li>

       <% }) %>
    </ul>
</section>
</body>
</html>