<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ayCode Library</title>
    <link rel="stylesheet" href="/output.css">
</head>
<body class="bg-gray-300 flex flex-col min-h-screen ">
    <%- include('navbar') %>
<section class="grid grid-cols-1 gap-5 sm:grid-cols-2 ">
    <h1 class="px-5 mt-11 mb-6 text-3xl font-bold">Summary of Courses and Books </h1>
   
    <div class=" m-5 rounded-2xl bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-slate-700">Total Courses</h2>
    <p class="mt-4 text-5xl font-bold text-red-600"> <%= courseLength %> </p>
      <a href="/courses"
               class="mt-6 inline-block font-semibold text-red-600 hover:underline">
                View courses &rarr;
            </a>
   </div>
   <div class=" m-5 rounded-2xl bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-slate-700">Total Number of Books</h2>
    <p class="mt-4 text-5xl font-bold text-red-600"> <%= bookLength %> </p>
    <a href="/listBooks"
               class="mt-6 inline-block font-semibold text-red-600 hover:underline">
                View books &rarr;
            </a>
   </div>
   
   
</section>
</body>
</html>