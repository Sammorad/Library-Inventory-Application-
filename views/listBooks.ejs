<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
     <link rel="stylesheet" href="/output.css">
</head>
<body>
    <%- include('navbar')%>
   <section>
     <div class="m-5 w-5/6 py-5">
        <h1 class="text-4xl">List of Books</h1>  
     </div>
     <table class="w-5/6 text-left border-collapse text-slate-950 table-auto md:table-fixed px-5 bg-white">
        <tr>
            <th class="p-5 font-bold">S/N</th>
            <th class="p-5 font-bold">Title</th>
            <th class="p-5 font-bold">Author</th>
            <th class="p-5 font-bold">Page</th>
            
            <th class="p-5 font-bold">Course</th>
        </tr>
        
        <% listOfBooks.forEach((item,index)=>{ %>
            <tr><td class="p-3"><%= index + 1 %></td>
                <td><%= item.title %></td>
                <td><%= item.author %></td>
                <td><%= item.pages %></td>
                <td>
                    <%= item.course %>
                </td>
            </tr>

       <% })%>
        

     </table>
   </section>

</body>
</html>